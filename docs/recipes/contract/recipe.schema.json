{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "2"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "youtube",
            "youtube_shorts",
            "instagram",
            "web",
            "photo",
            "text",
            "manual"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z_]+:.+$"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https:\\/\\/"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "channel": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "published_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "servings": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "description",
                "caption_manual",
                "caption_auto",
                "asr",
                "screen",
                "user"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "properties": {
        "cuisine": {
          "type": "string",
          "enum": [
            "한식",
            "양식",
            "일식",
            "중식",
            "기타"
          ]
        },
        "mains": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "돼지고기",
              "소고기",
              "닭고기",
              "기타 육류",
              "해산물",
              "달걀",
              "두부·콩",
              "채소",
              "버섯",
              "면",
              "밥·곡물",
              "빵·밀가루",
              "유제품",
              "기타"
            ]
          }
        },
        "main_details": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "methods": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "볶음",
              "구이",
              "조림",
              "찜",
              "국·탕",
              "찌개·전골",
              "튀김",
              "무침",
              "부침·전",
              "비빔",
              "샐러드",
              "오븐",
              "끓이기",
              "기타"
            ]
          }
        },
        "occasions": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "반찬",
              "한그릇",
              "국물",
              "술안주",
              "손님상",
              "도시락",
              "간식·디저트",
              "아침",
              "소스·양념"
            ]
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "쉬움",
            "보통",
            "어려움"
          ]
        }
      },
      "required": [
        "cuisine",
        "mains",
        "main_details",
        "methods",
        "occasions"
      ],
      "additionalProperties": false
    },
    "ingredients": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "at_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "suggested_amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "suggested_unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredient_key": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,60}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "amount",
          "unit",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "measuring_tool": {
      "type": "string",
      "enum": [
        "계량스푼",
        "밥숟가락",
        "섞어 씀",
        "확인 못 함"
      ]
    },
    "measuring_tool_basis": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "at_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "origin",
          "at_seconds"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "heat": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "cue": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "cue_origin": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "description",
                  "caption_manual",
                  "caption_auto",
                  "asr",
                  "screen",
                  "user",
                  "editor"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "editor_tip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "timer_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "video_start_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "uses": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 60
                },
                "portion": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 30
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "body",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "principles": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "video_start_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "body",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "about": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "chosen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "chosen_origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "other": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "other_origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "video_start_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "about",
          "chosen",
          "chosen_origin",
          "other",
          "other_origin"
        ],
        "additionalProperties": false
      }
    },
    "glossary": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "origin": {
            "type": "string",
            "enum": [
              "description",
              "caption_manual",
              "caption_auto",
              "asr",
              "screen",
              "user",
              "editor"
            ]
          },
          "at_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "term",
          "body",
          "origin",
          "at_seconds"
        ],
        "additionalProperties": false
      }
    },
    "corrections": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "description",
                  "caption_manual",
                  "caption_auto",
                  "asr",
                  "screen",
                  "user",
                  "editor"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "at_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "rule",
              "compare"
            ]
          }
        },
        "required": [
          "target",
          "before",
          "after",
          "origin",
          "at_seconds",
          "method"
        ],
        "additionalProperties": false
      }
    },
    "review_items": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "candidates": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 80
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "description",
                    "caption_manual",
                    "caption_auto",
                    "asr",
                    "screen",
                    "user",
                    "editor"
                  ]
                },
                "at_seconds": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "value",
                "origin",
                "at_seconds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "reason",
          "candidates"
        ],
        "additionalProperties": false
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          }
        },
        "transcript_kind": {
          "type": "string",
          "enum": [
            "caption_manual",
            "caption_auto",
            "asr",
            "none"
          ]
        },
        "tools": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "extracted_by": {
          "type": "string",
          "maxLength": 80
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "gaps": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "not_checked": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "required": [
        "levels",
        "transcript_kind",
        "tools",
        "extracted_by",
        "extracted_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "source",
    "title",
    "servings",
    "tags",
    "ingredients",
    "steps",
    "extraction"
  ],
  "additionalProperties": false
}
