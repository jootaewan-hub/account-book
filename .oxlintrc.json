{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react/exhaustive-deps": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-explicit-any": "warn",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 5 }],
    "jsx-a11y/control-has-associated-label": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/refs": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "no-control-regex": "off"
  },
  "ignorePatterns": ["dist/", "node_modules/", "screenshots/", "docs/", "supabase/functions/**/deno.lock"],
  "env": { "browser": true, "es2024": true, "node": true },
  "globals": { "Deno": "readonly", "__APP_VERSION__": "readonly" }
}
